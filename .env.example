# Salin file ini menjadi .env lalu isi dengan kredensial TiDB Cloud Anda
DATABASE_URL=mysql://<USER>:<PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/mypajak?ssl={"rejectUnauthorized":true}

NUXT_TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
NUXT_TIDB_PORT=4000
NUXT_TIDB_USER=your_tidb_user
NUXT_TIDB_PASSWORD=your_tidb_password
NUXT_TIDB_DATABASE=mypajak
NUXT_TIDB_SSL=true

NUXT_SESSION_SECRET=ganti-dengan-kunci-rahasia-panjang
